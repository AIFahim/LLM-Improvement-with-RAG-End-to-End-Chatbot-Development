# =============================================================================
# LLM Configuration
# =============================================================================

# LLM Provider: "ollama" or "azure"
LLM_PROVIDER=ollama
LLM_TEMPERATURE=0.7

# Ollama Configuration
OLLAMA_MODEL=llama3.2:1b
OLLAMA_BASE_URL=http://localhost:11434

# Azure OpenAI Configuration (required if LLM_PROVIDER=azure)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# =============================================================================
# Document Processing
# =============================================================================

CHUNK_SIZE=1500
CHUNK_OVERLAP=200
COLLECTION_NAME=pdf_documents

# =============================================================================
# Langfuse Observability (Optional)
# =============================================================================

# Set to "true" to enable Langfuse tracing
LANGFUSE_ENABLED=false

# Get keys from https://cloud.langfuse.com or self-host
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# =============================================================================
# Evaluation Configuration
# =============================================================================

# Set to "true" to enable automatic response evaluation
EVALUATION_ENABLED=false
EVALUATION_MODEL=llama3.2:1b

# =============================================================================
# Performance Configuration
# =============================================================================

# Response caching
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=100

# Retry configuration
MAX_RETRIES=3
RETRY_DELAY_SECONDS=1.0

# =============================================================================
# API Configuration
# =============================================================================

API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# =============================================================================
# Agent Configuration (Class 11)
# =============================================================================

AGENT_VERBOSE=true
AGENT_MAX_ITERATIONS=10
MEMORY_TYPE=buffer
MEMORY_K=5
WEB_SEARCH_MAX_RESULTS=5

# =============================================================================
# Vision Configuration (Class 11 - Multimodal)
# =============================================================================

# Enable/disable vision capabilities
VISION_ENABLED=true

# Vision model (must be pulled in Ollama: ollama pull llava:7b)
VISION_MODEL=llava:7b
VISION_BASE_URL=http://localhost:11434

# Image processing limits
VISION_MAX_IMAGE_SIZE_MB=10
VISION_MAX_TOKENS=1024

# =============================================================================
# Voice Configuration (Class 11 - Multimodal)
# =============================================================================

# Enable/disable voice capabilities
VOICE_ENABLED=true

# STT engine: "whisper" (local) or "google" (online fallback)
STT_ENGINE=whisper
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu

# TTS engine: "gtts" (online), "pyttsx3" (offline), or "orpheus" (Ollama, natural speech)
TTS_ENGINE=gtts
TTS_LANGUAGE=en

# Orpheus TTS Configuration (requires: ollama pull legraphista/Orpheus)
ORPHEUS_MODEL=legraphista/Orpheus
ORPHEUS_BASE_URL=http://localhost:11434
# Voices: tara, leah, jess, leo, dan, mia, zac, zoe
ORPHEUS_VOICE=tara

# Audio settings
AUDIO_SAMPLE_RATE=16000
AUDIO_MAX_DURATION_SECONDS=120

# =============================================================================
# Multimodal Agent Configuration (Class 11)
# =============================================================================

# Agent mode: "full", "text", "vision", "voice"
MULTIMODAL_MODE=full

# Automatically generate speech for agent responses
MULTIMODAL_AUTO_TTS=false

# Verbose agent logging
MULTIMODAL_AGENT_VERBOSE=true
