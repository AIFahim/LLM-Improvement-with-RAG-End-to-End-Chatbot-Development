# =============================================================================
# LLM Configuration
# =============================================================================

# LLM Provider: "ollama" or "azure"
LLM_PROVIDER=ollama
LLM_TEMPERATURE=0.7

# Ollama Configuration
OLLAMA_MODEL=llama3.2:1b
OLLAMA_BASE_URL=http://localhost:11434

# Azure OpenAI Configuration (required if LLM_PROVIDER=azure)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# =============================================================================
# Document Processing
# =============================================================================

CHUNK_SIZE=1500
CHUNK_OVERLAP=200
COLLECTION_NAME=pdf_documents

# =============================================================================
# Langfuse Observability (Optional)
# =============================================================================

# Set to "true" to enable Langfuse tracing
LANGFUSE_ENABLED=false

# Get keys from https://cloud.langfuse.com or self-host
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# =============================================================================
# Evaluation Configuration
# =============================================================================

# Set to "true" to enable automatic response evaluation
EVALUATION_ENABLED=false
EVALUATION_MODEL=llama3.2:1b

# =============================================================================
# Performance Configuration
# =============================================================================

# Response caching
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=100

# Retry configuration
MAX_RETRIES=3
RETRY_DELAY_SECONDS=1.0

# =============================================================================
# API Configuration
# =============================================================================

API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
